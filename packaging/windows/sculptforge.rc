// SculptForge Windows resources: application icon and version information.
#include <winver.h>

IDI_ICON1 ICON "@ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "The SculptForge contributors"
      VALUE "FileDescription", "SculptForge - digital sculpting"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "LegalCopyright", "Copyright (C) 2026 The SculptForge contributors. GPL-3.0-or-later."
      VALUE "ProductName", "SculptForge"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
