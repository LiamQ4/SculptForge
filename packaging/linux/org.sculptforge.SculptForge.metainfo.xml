<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.sculptforge.SculptForge</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>SculptForge</name>
  <summary>Digital sculpting for artists and game pipelines</summary>
  <developer id="org.sculptforge">
    <name>The SculptForge contributors</name>
  </developer>
  <description>
    <p>SculptForge is a free and open-source alternative to ZBrush: a digital sculpting application with familiar brushes,
    symmetry, sculpt layers, voxel remeshing and one-click LOD chains.</p>
    <p>It exports game-ready FBX, glTF and OpenUSD files, can send assets straight into the Unreal Editor,
    works with Gaussian splats, and includes free AI tools (or bring your own): describe a brush in words,
    or turn an image or a description into a sculptable 3D model.</p>
  </description>
  <launchable type="desktop-id">org.sculptforge.SculptForge.desktop</launchable>
  <url type="homepage">https://islandmed.github.io/SculptForge/</url>
  <url type="bugtracker">https://github.com/islandmed/SculptForge/issues</url>
  <url type="vcs-browser">https://github.com/islandmed/SculptForge</url>
  <screenshots>
    <screenshot type="default">
      <image>https://islandmed.github.io/SculptForge/media/screenshot-sculpt.jpg</image>
      <caption>Sculpting a creature with symmetry</caption>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.4.2" date="2026-10-23"/>
    <release version="0.4.1" date="2026-10-23"/>
    <release version="0.4.0" date="2026-10-22"/>
    <release version="0.3.0" date="2026-10-22"/>
    <release version="0.2.0" date="2026-10-21"/>
    <release version="0.1.0" date="2026-10-20"/>
  </releases>
  <provides>
    <binary>sculptforge</binary>
    <binary>sculptforge-cli</binary>
  </provides>
</component>
