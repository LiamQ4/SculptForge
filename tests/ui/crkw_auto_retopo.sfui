run ui_look look=classic layout=classic
input_style classic
run new_sphere subdivisions=4
snapshot
click "Clay##brush.clay"
stroke 0.35 0.4 0.65 0.5
remember vertices source_points
remember parts original_count
click "Script##palette.script"
expect "Auto Retopo + Project##crkw.auto_retopo"
click "Auto Retopo + Project##crkw.auto_retopo"
expect_status Auto Retopo: source/history kept
expect_value parts == 2
expect_value active_part == 1
expect_value sdiv_levels > 1
shot auto-retopo-result
key shift+d
expect_value subdiv_level > 0
run part_select index=0
expect_value vertices == $source_points
expect_value can_undo == 1
shot preserved-source-history
