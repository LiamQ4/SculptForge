run ui_look look=classic layout=classic
input_style classic
# CRKW: Generate 3D's picture box takes Ctrl+V while hovered, and Ctrl+V there is not Paste brush.
drop ../../assets/demo/teddy-sketch.png
wait_for "Generate 3D" 5
expect "Generate 3D/##imagebox"
hover "Generate 3D/##imagebox"
clipboard this is neither an image nor a file
key ctrl+v
expect_status No image on the clipboard
shot paste-box
clipboard_image $SCRIPT_DIR/../../assets/demo/teddy-sketch.png
key ctrl+v
expect_status Pasted image
shot pasted-image
